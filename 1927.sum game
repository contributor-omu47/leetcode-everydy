If this condition does not hold, Alice wins.
Python 3 Implementation
class Solution:
    def sumGame(self, num: str) -> bool:
        n = len(num)
        mid = n // 2
        
        left_sum = 0
        left_q = 0
        for ch in num[:mid]:
            if ch == '?':
                left_q += 1
            else:
                left_sum += int(ch)
                
        right_sum = 0
        right_q = 0
        for ch in num[mid:]:
            if ch == '?':
                right_q += 1
            else:
                right_sum += int(ch)
                
        # Bob wins only if the sums balance out with the ? difference
        # Condition: (left_sum - right_sum) + (left_q - right_q) * 4.5 == 0
        # Multiplied by 2 to avoid floating point issues:
        return 2 * (left_sum - right_sum) != 9 * (right_q - left_q)

 * Time Complexity: O(n)
 * Space Complexity: O(1)
